@{
    ViewData["Title"] = "My Profile";
}
<section class="profile-layout">
    <aside class="profile-menu">
        <div class="profile-avatar">@((ViewBag.DisplayName as string ?? "U").Substring(0,1).ToUpper())</div>
        <h1>@ViewBag.DisplayName</h1>
        <p>@ViewBag.Role account</p>
        <nav>
            @if (ViewBag.Role == "Seller")
            {
                <a asp-controller="Parts" asp-action="Manage">Inventory</a>
                <a asp-controller="Orders" asp-action="Seller">Seller orders</a>
            }
            else
            {
                <a asp-controller="Orders" asp-action="Index">Order history</a>
            }
        </nav>
    </aside>
    <section class="profile-content">
        <p class="eyebrow">ACCOUNT DETAILS</p>
        <h2>Profile information</h2>
        <dl>
            <div><dt>Full name</dt><dd>@ViewBag.DisplayName</dd></div>
            <div><dt>Email address</dt><dd>@ViewBag.Email</dd></div>
            <div><dt>Account role</dt><dd>@ViewBag.Role</dd></div>
        </dl>
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="secondary-button">Sign out</button>
        </form>
    </section>
</section>
