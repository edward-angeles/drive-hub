@model List<DriveHub.Models.OrderItem>
@using DriveHub.Models
@using System.Globalization

@{
    ViewData["Title"] = "Seller Orders";
    var items = Model ?? new List<OrderItem>();
    var cad = CultureInfo.GetCultureInfo("en-CA");
    var pendingItems = items.Count(x => x.FulfillmentStatus == FulfillmentStatus.Pending);
    var acceptedItems = items.Count(x => x.FulfillmentStatus == FulfillmentStatus.Accepted);
    var shippedItems = items.Count(x => x.FulfillmentStatus == FulfillmentStatus.Shipped);
    var merchandiseValue = items.Sum(x => x.LineTotalCents);
}

<section class="seller-dashboard">
    <div class="seller-heading">
        <div>
            <p class="seller-eyebrow">DRIVE HUB / SELLER PORTAL</p>
            <h1>Incoming Orders</h1>
            <p>Review purchases and update fulfillment as orders progress.</p>
        </div>
        <a asp-controller="Parts" asp-action="Manage" class="secondary-button">Back to Inventory</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="seller-alert success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="seller-alert error">@TempData["Error"]</div>
    }

    <div class="seller-stats">
        <article class="seller-stat-card"><span>Order Items</span><strong>@items.Count</strong><small>All purchased line items</small></article>
        <article class="seller-stat-card"><span>Pending</span><strong>@pendingItems</strong><small>Awaiting your review</small></article>
        <article class="seller-stat-card"><span>Accepted / Shipped</span><strong>@(acceptedItems + shippedItems)</strong><small>@acceptedItems accepted · @shippedItems shipped</small></article>
        <article class="seller-stat-card"><span>Item Value</span><strong>@((merchandiseValue / 100m).ToString("C", cad))</strong><small>Value of listed order items</small></article>
    </div>

    <section class="seller-inventory-panel">
        <div class="seller-panel-heading">
            <h2>Customer Purchases</h2>
            <span>@items.Count order items</span>
        </div>

        @if (items.Count == 0)
        {
            <div class="seller-empty">
                <h3>No orders yet</h3>
                <p>Purchased parts will appear here when buyers place orders.</p>
                <a asp-controller="Parts" asp-action="Manage" class="primary-button">Manage Inventory</a>
            </div>
        }
        else
        {
            <div class="tablewrap">
                <table class="seller-table">
                    <thead>
                        <tr>
                            <th>Part</th>
                            <th>Order</th>
                            <th>Qty</th>
                            <th>Value</th>
                            <th>Fulfillment</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            var statusClass = item.FulfillmentStatus switch
                            {
                                FulfillmentStatus.Pending => "pending",
                                FulfillmentStatus.Accepted => "accepted",
                                FulfillmentStatus.Shipped => "shipped",
                                FulfillmentStatus.Completed => "completed",
                                FulfillmentStatus.Cancelled => "cancelled",
                                _ => ""
                            };
                            <tr>
                                <td><strong>@item.PartName</strong><small>Part ID: @item.PartId</small></td>
                                <td><small>@item.OrderId</small></td>
                                <td>@item.Quantity</td>
                                <td>@((item.LineTotalCents / 100m).ToString("C", cad))</td>
                                <td><span class="fulfillment-status @statusClass">@item.FulfillmentStatus</span></td>
                                <td class="seller-order-actions">
                                    @if (item.FulfillmentStatus == FulfillmentStatus.Pending)
                                    {
                                        <form asp-controller="Orders" asp-action="UpdateFulfillment" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="hidden" name="newStatus" value="Accepted" />
                                            <button type="submit" class="small-action">Accept</button>
                                        </form>
                                        <form asp-controller="Orders" asp-action="UpdateFulfillment" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="hidden" name="newStatus" value="Cancelled" />
                                            <button type="submit" class="small-action danger-action">Cancel</button>
                                        </form>
                                    }
                                    else if (item.FulfillmentStatus == FulfillmentStatus.Accepted)
                                    {
                                        <form asp-controller="Orders" asp-action="UpdateFulfillment" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="hidden" name="newStatus" value="Shipped" />
                                            <button type="submit" class="small-action">Mark Shipped</button>
                                        </form>
                                    }
                                    else if (item.FulfillmentStatus == FulfillmentStatus.Shipped)
                                    {
                                        <form asp-controller="Orders" asp-action="UpdateFulfillment" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="hidden" name="newStatus" value="Completed" />
                                            <button type="submit" class="small-action">Complete</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="no-order-action">No action</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
