@{
    ViewData["Title"] = "About";
}
<section class="content-hero">
    <p class="eyebrow">ABOUT DRIVE HUB</p>
    <h1>Built for the people who keep vehicles moving.</h1>
    <p>Drive Hub connects independent sellers with buyers looking for new, used, and refurbished automotive parts.</p>
</section>
<section class="about-grid">
    <article><h2>Our purpose</h2><p>Make part discovery easier by bringing search, vehicle fitment, specifications, and seller inventory into one marketplace.</p></article>
    <article><h2>Fitment first</h2><p>Vehicle compatibility is seller-maintained and displayed clearly. Buyers should always confirm fitment before purchase.</p></article>
    <article><h2>Transparent listings</h2><p>Grades, warranties, mileage, condition, and seller-entered quality scores help buyers compare parts side by side.</p></article>
</section>
<section class="map-section" style="margin-top: 32px;">
    <h2>Find parts near you</h2>
    <p>Enter an address or postal code to see the approximate area.</p>
    <div style="margin-bottom: 12px;">
        <input id="address" type="text" placeholder="Address or postal code" />
        <button id="searchBtn" type="button" class="primary-button">Search</button>
        <p id="error" style="color: #b91c1c;"></p>
    </div>
    <div id="map" style="height: 400px; border-radius: 8px;"></div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
}

