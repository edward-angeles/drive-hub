@{
    ViewData["Title"] = "Home";
}
<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Drive Hub is a web application that allows users to buy car parts.</p>
    <a asp-controller="Parts" asp-action="Index" class="btn btn-primary">Browse Parts</a>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-primary">My Orders</a>

        @if (User.IsInRole("Seller"))
        {
            <a asp-controller="Parts" asp-action="Manage" class="btn btn-success">Manage Inventory</a>
            <a asp-controller="Orders" asp-action="Seller" class="btn btn-outline-success">Seller Orders</a>
        }
    }
    else
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-success">Create an Account</a>
    }
</div>