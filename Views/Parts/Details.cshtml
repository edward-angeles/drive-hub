@model CarPart

@{
    ViewData["Title"] = Model.Name;
}

<div class="breadcrumb"><a asp-action="Index">Marketplace</a><span>/</span><span>@Model.Name</span></div>
<div class="detail-layout">
<section class="detail-card">
    <div class="detail-visual">
        <span>@Model.Category</span>
        <strong>@Model.Manufacturer</strong>
    </div>
</section>
<section class="detail-info">
    <span class="eyebrow">@Model.Category • @Model.Condition</span>
    <h1>@Model.Name</h1>
    <p class="detail-subtitle">@Model.Manufacturer · @Model.PartNumber</p>
    <h2 class="detail-price">@Model.Price.ToString("C")</h2>
    <div class="stock-line @(Model.Quantity == 0 ? "out" : "")">@((Model.Quantity == 0) ? "Out of stock" : $"{Model.Quantity} in stock")</div>


    <h3>Specifications</h3>
    <div class="spec-grid">
        <div><span>Grade</span><strong>@Model.Grade</strong></div>
        <div><span>Quality score</span><strong>@Model.QualityScore/100</strong></div>
        <div><span>Warranty</span><strong>@Model.WarrantyMonths months</strong></div>
        @if (Model.MileageKm.HasValue) { <div><span>Mileage</span><strong>@Model.MileageKm.Value.ToString("N0") km</strong></div> }
    </div>
    <h3>Compatible vehicle</h3>
    @if (Model.VehicleYear.HasValue && !string.IsNullOrWhiteSpace(Model.VehicleMakeName))
    {
        <p class="compatibility">@Model.VehicleYear @Model.VehicleMakeName @Model.VehicleModelName</p>
        <small>Seller-declared fitment. Verify compatibility before purchase.</small>
    }
    else
    { <p>No compatible vehicle specified.</p> }
    <h3>Description</h3>
    <p>@Model.Description</p>
</section>
</div>
