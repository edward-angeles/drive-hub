@model CarPart
<section class="seller-form-page">
    <div class="seller-heading"><div><p class="seller-eyebrow">SELLER PORTAL / INVENTORY</p><h1>Edit car part</h1><p>Update listing details, stock, pricing, and compatibility.</p></div></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="seller-inventory-panel">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id"/>
        <partial name="_PartForm" model="Model"/>
    </form>
</section>
