<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Drive Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="brand" asp-controller="Parts" asp-action="Index">DRIVE HUB</a>
        <nav class="site-nav" aria-label="Primary navigation">
            <a asp-controller="Parts" asp-action="Index">Marketplace</a>
            <a asp-page="/Index">Welcome</a>
            <a asp-page="/Privacy">Privacy</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Orders" asp-action="Index">My orders</a>

                @if (User.IsInRole("Seller"))
                {
                    <a asp-controller="Parts" asp-action="Manage">Inventory</a>
                    <a asp-controller="Orders" asp-action="Seller">Seller orders</a>
                }

                <span>Hello, @User.Identity.Name!</span>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                    <button type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Sign in</a>
                <a asp-controller="Account" asp-action="Register">Create account</a>
            }
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>Drive Hub • Educational prototype • No real purchases</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>